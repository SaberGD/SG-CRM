rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role lookups - Using exists() and get() safely
    function hasRole(role) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(userPath) && get(userPath).data.role == role;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email.lower() == "saber.gd.fl@gmail.com" || hasRole('admin'));
    }

    function isManager() {
      return isAdmin() || hasRole('manager');
    }

    function isTeamLeader() {
      return isManager() || hasRole('team_leader');
    }

    function isSalesAgent() {
      return hasRole('sales_agent');
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'createdAt']) &&
             data.email is string && data.email.size() <= 100 &&
             data.name is string && data.name.size() <= 100 &&
             data.role in ['admin', 'manager', 'team_leader', 'sales_agent'] &&
             data.createdAt is int;
    }

    function isValidClient(data) {
       return data.keys().hasAll(['name', 'phone', 'serviceName', 'status', 'salesAgentId', 'salesAgentName', 'createdAt']) &&
              data.name is string && data.name.size() <= 100 &&
              data.phone is string && data.phone.size() <= 20 &&
              data.serviceName is string && data.serviceName.size() <= 100 &&
              data.status is string &&
              data.salesAgentId is string &&
              data.salesAgentName is string &&
              data.createdAt is int;
    }

    // --- Collections ---

    // USERS
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isTeamLeader() || isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().role == 'sales_agent';
      allow update: if (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoUrl', 'updatedAt'])) ||
                    (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'name', 'email']));
      allow delete: if isAdmin();
    }

    // CLIENTS
    match /clients/{clientId} {
      allow get: if isSignedIn() && (isTeamLeader() || existing().salesAgentId == request.auth.uid);
      allow list: if isSignedIn() && (isTeamLeader() || resource.data.salesAgentId == request.auth.uid);
      allow create: if isSignedIn() && isValidClient(incoming()) && (incoming().salesAgentId == request.auth.uid || isTeamLeader());
      allow update: if isSignedIn() && (isTeamLeader() || existing().salesAgentId == request.auth.uid) && 
                    (isAdmin() || incoming().diff(existing()).affectedKeys().size() > 0); 
      allow delete: if isAdmin();
    }

    // FOLLOWUPS
    match /followups/{id} {
      allow read: if isSignedIn() && (isTeamLeader() || resource.data.agentId == request.auth.uid);
      allow create: if isSignedIn() && incoming().agentId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // LOGS
    match /logs/{id} {
      allow read: if isTeamLeader();
      allow create: if isSignedIn();
    }

    // REPORTS
    match /reports/{id} {
      allow read: if isTeamLeader() || resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if (isOwner(existing().userId) || isManager()) && incoming().userId == existing().userId;
      allow delete: if isAdmin();
    }

    // SERVICES
    match /services/{id} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    // LABELS
    match /labels/{id} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    // INVITATIONS
    match /invitations/{id} {
      function canReadInvite() {
        return isTeamLeader() || (request.auth.token.email.lower() == resource.data.email.lower());
      }
      allow read: if isSignedIn() && canReadInvite();
      allow create: if isManager();
      allow update: if isSignedIn() && (isManager() || (request.auth.token.email.lower() == existing().email.lower() && incoming().diff(existing()).affectedKeys().hasOnly(['status'])));
      allow delete: if isManager();
    }

    // TARGETS
    match /targets/{id} {
      allow read: if isSignedIn() && (isTeamLeader() || id.startsWith(request.auth.uid));
      allow write: if isManager();
    }

    match /defaultTargets/{id} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    // TRANSFERS
    match /transfers/{id} {
      allow read: if isTeamLeader() || resource.data.oldAgentId == request.auth.uid || resource.data.newAgentId == request.auth.uid;
      allow create: if isTeamLeader();
    }

    // BULK TRANSFERS
    match /bulk_transfers/{id} {
      allow read: if isSignedIn() && (request.auth.token.email.lower() == "saber.gd.fl@gmail.com" || isTeamLeader());
      allow create: if isManager();
      allow update: if isManager();
    }
  }
}
