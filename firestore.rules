
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: name (string), email (string), role (string), createdAt (number)
    //
    // Collection: clients
    // Fields: name (string), phone (string), status (string), salesAgentId (string), salesAgentName (string)
    //
    // Collection: reports
    // Fields: userId (string), userName (string), date (string), submittedAt (number)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "saber.gd.fl@gmail.com" ||
        (userExists() && getUserData().get('role', '') in ['admin', 'administrator'])
      );
    }
    
    function isManager() {
      return isAdmin() || (userExists() && getUserData().get('role', '') in ['manager', 'supervisor']);
    }
    
    function isTeamLeader() {
      return isManager() || (userExists() && getUserData().get('role', '') in ['team_leader', 'leader']);
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidReport(data) {
      return hasRequiredFields(['userId', 'userName', 'date', 'submittedAt']) &&
             (data.userId == request.auth.uid || isManager()) &&
             data.date is string && data.submittedAt is number;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // قواعد مجموعة المستخدمين
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }
    
    // قواعد العملاء
    match /clients/{clientId} {
      allow read: if isAuthenticated(); 
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // قواعد المتابعات
    match /followups/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isManager();
    }
    
    // قواعد الدعوات
    match /invitations/{id} {
      allow read: if true; 
      allow create, delete: if isTeamLeader();
      allow update: if isTeamLeader() || (isAuthenticated() && request.auth.token.email == resource.data.email);
    }
    
    // قواعد السجلات
    match /logs/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }
    
    // قواعد الخدمات والتصنيفات
    match /services/{id} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }
    
    match /labels/{id} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }
    
    // قواعد التقارير والتحويلات
    match /reports/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidReport(request.resource.data);
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
    }
    
    match /targets/{id} {
      allow read: if isAuthenticated();
      allow write: if isTeamLeader();
    }
    
    match /defaultTargets/{id} {
      allow read: if isAuthenticated();
      allow write: if isTeamLeader();
    }
    
    match /transfers/{id} {
      allow read: if isTeamLeader() || resource.data.oldAgentId == request.auth.uid || resource.data.newAgentId == request.auth.uid;
      allow create: if isTeamLeader();
    }

    match /bulk_transfers/{id} {
      allow read: if isTeamLeader();
      allow create, update: if isTeamLeader();
    }
  }
}
