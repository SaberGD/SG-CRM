rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Access model
    // ---------------------------------------------------------------
    // Being signed in with Google is NOT enough. Every read and write needs a
    // users/{uid} profile that is not deactivated. A profile can only be created
    // by an admin, or by the person themself when an active invitation
    // (allowed_users/{email}, written by the invitations page) grants that exact role.
    // Roles can never be changed by their owner.
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwnerAccount() {
      return isAuthenticated() &&
        request.auth.token.email == "saber.gd.fl@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    // A real, active staff member: signed in + has a profile + not deactivated.
    function isStaff() {
      return isOwnerAccount() ||
        (isAuthenticated() && userExists() && getUserData().get('isDeactivated', false) != true);
    }

    function roleIn(roles) {
      return isStaff() && userExists() && getUserData().get('role', '') in roles;
    }

    function isAdmin() {
      return isOwnerAccount() || roleIn(['admin', 'administrator']);
    }

    function isManager() {
      return isAdmin() || roleIn(['manager', 'supervisor']);
    }

    function isTeamLeader() {
      return isManager() || roleIn(['team_leader', 'leader']);
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function changed(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // The invitation mirror written when a leader invites someone.
    function invitationFor(email) {
      return get(/databases/$(database)/documents/allowed_users/$(email)).data;
    }

    function hasActiveInvitation(email, role) {
      return exists(/databases/$(database)/documents/allowed_users/$(email)) &&
        invitationFor(email).get('isActive', true) == true &&
        invitationFor(email).get('role', '') == role;
    }

    function isValidReport(data) {
      return hasRequiredFields(['userId', 'userName', 'date', 'submittedAt']) &&
             (data.userId == request.auth.uid || isManager()) &&
             data.date is string && data.submittedAt is number;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      // Admin creates anyone. A person may create ONLY their own profile, only
      // with the role an active invitation gave them (or the owner account).
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.email == request.auth.token.email &&
        (isOwnerAccount() || hasActiveInvitation(request.auth.token.email, request.resource.data.role))
      );
      // An owner may only touch harmless fields; role/deactivation are admin-only.
      allow update: if isAdmin() || (
        isOwner(userId) && isStaff() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL', 'lastSeenAt'])
      );
      allow delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow read: if isStaff();
      // A sales agent creates clients for themself; leaders can create for anyone.
      allow create: if isStaff() && (request.resource.data.get('salesAgentId', '') == request.auth.uid || isTeamLeader());
      allow update: if isAdmin() || (
        isStaff() &&
        (isTeamLeader() || resource.data.get('salesAgentId', '') == request.auth.uid) &&
        // AI recommendations and accounting-synced fields are written by the server only.
        !changed(['aiRecommendation', 'accountingBookingIds', 'accountingLastSyncedAt', 'accounting']) &&
        // Handing a client to someone else is a transfer: leaders only.
        (isTeamLeader() || !changed(['salesAgentId', 'salesAgentName']))
      );
      allow delete: if isAdmin();
    }

    match /followups/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && (request.resource.data.get('agentId', '') == request.auth.uid || isTeamLeader());
      allow update, delete: if isManager();
    }

    // Invitations are private: leaders manage them; an invited person can read and
    // mark only their own (needed by the sign-in flow).
    match /invitations/{id} {
      allow read: if isTeamLeader() ||
        (isAuthenticated() && resource.data.get('email', '') == request.auth.token.email);
      allow create, delete: if isTeamLeader();
      allow update: if isTeamLeader() ||
        (isAuthenticated() && resource.data.get('email', '') == request.auth.token.email &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
    }

    // Mirror used by the rules above (docId = lower-case email). Leaders write it
    // together with the invitation.
    match /allowed_users/{email} {
      allow read: if isTeamLeader() || (isAuthenticated() && request.auth.token.email == email);
      allow write: if isTeamLeader();
    }

    match /logs/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
    }

    match /services/{id} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    match /labels/{id} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    match /reports/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidReport(request.resource.data);
      allow update: if isStaff() && (resource.data.userId == request.auth.uid || isManager());
      allow delete: if isStaff() && (resource.data.userId == request.auth.uid || isManager());
    }

    match /targets/{id} {
      allow read: if isStaff();
      allow write: if isTeamLeader();
    }

    match /defaultTargets/{id} {
      allow read: if isStaff();
      allow write: if isTeamLeader();
    }

    match /transfers/{id} {
      allow read: if isTeamLeader() || (isStaff() && (resource.data.oldAgentId == request.auth.uid || resource.data.newAgentId == request.auth.uid));
      allow create: if isTeamLeader();
    }

    match /bulk_transfers/{id} {
      allow read: if isTeamLeader();
      allow create, update: if isTeamLeader();
    }

    match /shifts/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isStaff() && (resource.data.userId == request.auth.uid || isManager());
    }
  }
}
