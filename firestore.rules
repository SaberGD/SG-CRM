
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: name (string), email (string), role (string), createdAt (number)
    //
    // Collection: clients
    // Fields: name (string), phone (string), status (string), salesAgentId (string), salesAgentName (string)
    //
    // Collection: reports
    // Fields: userId (string), userName (string), date (string), submittedAt (number)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        (userExists() && (getUserData().role == 'admin' || getUserData().role == 'administrator')) || 
        (request.auth.token.email == "saber.gd.fl@gmail.com" && request.auth.token.email_verified == true)
      );
    }
    
    function isManager() {
      return isAdmin() || (isAuthenticated() && userExists() && (getUserData().role == 'manager' || getUserData().role == 'supervisor'));
    }
    
    function isTeamLeader() {
      return isManager() || (isAuthenticated() && userExists() && (getUserData().role == 'team_leader' || getUserData().role == 'leader'));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string &&
             data.role in ['admin', 'manager', 'team_leader', 'sales_agent'];
    }

    function isValidClient(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.phone is string && data.phone.size() > 0 &&
             data.salesAgentId is string &&
             (data.salesAgentId == request.auth.uid || isTeamLeader());
    }

    function isValidReport(data) {
      return data.userId is string && 
             (data.userId == request.auth.uid || isManager()) &&
             data.date is string &&
             data.submittedAt is number;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // قواعد مجموعة المستخدمين
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && (isOwner(userId) || isAdmin());
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }
    
    // قواعد العملاء
    match /clients/{clientId} {
      allow read: if isAuthenticated(); 
      allow create: if isAuthenticated() && isValidClient(request.resource.data);
      allow update: if isAuthenticated() && isValidClient(request.resource.data) && (isTeamLeader() || resource.data.salesAgentId == request.auth.uid);
      allow delete: if isManager();
    }
    
    // قواعد المتابعات
    match /followups/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isManager();
    }
    
    // قواعد الدعوات
    match /invitations/{id} {
      allow read: if isAuthenticated(); 
      allow write: if isTeamLeader();
    }
    
    // قواعد السجلات
    match /logs/{id} {
      allow read: if isTeamLeader();
      allow create: if isAuthenticated();
    }
    
    // قواعد الخدمات والتصنيفات
    match /services/{id} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }
    
    match /labels/{id} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }
    
    // قواعد التقارير والتحويلات
    match /reports/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidReport(request.resource.data);
      allow update: if isManager() && isValidReport(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isManager());
    }
    
    match /targets/{id} {
      allow read: if isAuthenticated();
      allow write: if isTeamLeader();
    }
    
    match /defaultTargets/{id} {
      allow read: if isAuthenticated();
      allow write: if isTeamLeader();
    }
    
    match /transfers/{id} {
      allow read: if isTeamLeader();
      allow create: if isTeamLeader();
    }
  }
}
