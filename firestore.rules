rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Access model
    // ---------------------------------------------------------------
    // Being signed in with Google is NOT enough. Every read and write needs a
    // users/{uid} profile that is not deactivated. A profile can only be created
    // by an admin, or by the person themself when an active invitation
    // (allowed_users/{email}, written by the invitations page) grants that exact role.
    // Roles can never be changed by their owner.
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwnerAccount() {
      return isAuthenticated() &&
        request.auth.token.email == "saber.gd.fl@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    // A real, active staff member: signed in + has a profile + not deactivated.
    function isStaff() {
      return isOwnerAccount() ||
        (isAuthenticated() && userExists() && getUserData().get('isDeactivated', false) != true);
    }

    // Flat (non-nested) role checks: the rules engine caps how many expressions one
    // request may evaluate, and nested helper chains used to hit that cap.
    function roleIn(roles) {
      return isAuthenticated() && userExists() && getUserData().get('isDeactivated', false) != true &&
        getUserData().get('role', '') in roles;
    }

    function isAdmin() {
      return isOwnerAccount() || roleIn(['admin', 'administrator']);
    }

    function isManager() {
      return isOwnerAccount() || roleIn(['admin', 'administrator', 'manager', 'supervisor']);
    }

    function isTeamLeader() {
      return isOwnerAccount() || roleIn(['admin', 'administrator', 'manager', 'supervisor', 'team_leader', 'leader']);
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function changed(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // The invitation mirror written when a leader invites someone.
    function invitationFor(email) {
      return get(/databases/$(database)/documents/allowed_users/$(email)).data;
    }

    function hasActiveInvitation(email, role) {
      return exists(/databases/$(database)/documents/allowed_users/$(email)) &&
        invitationFor(email).get('isActive', true) == true &&
        invitationFor(email).get('role', '') == role;
    }

    // Roles a non-admin leader may hand out through an invitation.
    function isSalesRole(role) {
      return role in ['sales_agent'];
    }

    // uid of the shared pool account the automation parks unassigned leads on. Stored in
    // app_settings/pool { uid } (written once by an admin, see docs/hardening-2026-11.md).
    function poolUid() {
      return exists(/databases/$(database)/documents/app_settings/pool)
        ? get(/databases/$(database)/documents/app_settings/pool).data.get('uid', '__no_pool__')
        : '__no_pool__';
    }

    // Clients a sales agent may see: their own plus the shared pool. Leaders see all.
    function ownOrPool(agentId) {
      return agentId == request.auth.uid || agentId == poolUid();
    }

    function canSeeClientId(clientId) {
      return clientId is string && clientId.size() > 0 && (
        exists(/databases/$(database)/documents/clients/$(clientId)) &&
        ownOrPool(get(/databases/$(database)/documents/clients/$(clientId)).data.get('salesAgentId', ''))
      );
    }

    // Shift timestamps written by the browser must be "now" (5 minutes of clock skew allowed).
    function isNowMs(v) {
      return v is number && v > request.time.toMillis() - 300000 && v < request.time.toMillis() + 300000;
    }

    function onlyKeys(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isValidReport(data) {
      return hasRequiredFields(['userId', 'userName', 'date', 'submittedAt']) &&
             (data.userId == request.auth.uid || isManager()) &&
             data.date is string && data.submittedAt is number;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      // Admin creates anyone. A person may create ONLY their own profile, only
      // with the role an active invitation gave them (or the owner account).
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.email == request.auth.token.email &&
        (isOwnerAccount() || hasActiveInvitation(request.auth.token.email, request.resource.data.role))
      );
      // An owner may only touch harmless fields; role/deactivation are admin-only.
      allow update: if isAdmin() || (
        isOwner(userId) && isStaff() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL', 'lastSeenAt'])
      );
      allow delete: if isAdmin();
    }

    match /clients/{clientId} {
      // Sales read their own clients and the shared pool; leaders read everything.
      // (List queries from sales must filter on salesAgentId in [me, pool] — the app does.)
      allow read: if isTeamLeader() || (isStaff() && ownOrPool(resource.data.salesAgentId));
      // A sales agent creates clients for themself; leaders can create for anyone.
      // Server-written fields can never be smuggled in on create.
      allow create: if isStaff() && (request.resource.data.get('salesAgentId', '') == request.auth.uid || isTeamLeader()) &&
        !request.resource.data.keys().hasAny(['snapshot360', 'courseEndsAt', 'alumniDue', 'activeBookingsCount', 'multiCourse',
          'aiRecommendation', 'accountingBookingIds', 'accountingLastSyncedAt', 'accounting']);
      // "Assign to me": a sales agent may take a client that sits on the shared pool account,
      // changing only the owner fields, and only to themself.
      allow update: if resource.data.get('salesAgentId', '') == poolUid() && isStaff() &&
        request.resource.data.get('salesAgentId', '') == request.auth.uid &&
        onlyKeys(['salesAgentId', 'salesAgentName', 'claimedFromPoolAt']);
      allow update: if isAdmin() || (
        (isTeamLeader() || (isStaff() && resource.data.get('salesAgentId', '') == request.auth.uid)) &&
        // AI recommendations, accounting-synced fields and the client 360 snapshot (and the
        // list fields derived from it / from the bookings) are written by the server only.
        // isAlumni / alumniSince are NOT here on purpose: the owner agent sets them from the
        // "حوّله لعميل سابق" button.
        !changed(['aiRecommendation', 'accountingBookingIds', 'accountingLastSyncedAt', 'accounting',
                  'snapshot360', 'courseEndsAt', 'alumniDue', 'activeBookingsCount', 'multiCourse']) &&
        // Money of a client linked to accounting bookings comes from accounting only.
        !(resource.data.get('accountingBookingIds', []).size() > 0 &&
          changed(['totalPrice', 'paidAmount', 'remainingAmount', 'bookedCourseName', 'bookedCourseId', 'bookingDate'])) &&
        // Handing a client to someone else is a transfer: leaders only.
        (isTeamLeader() || !changed(['salesAgentId', 'salesAgentName']))
      );
      allow delete: if isAdmin();
    }

    match /followups/{id} {
      // Sales read the follow-ups they wrote, and those of their own / pool clients
      // (clientAgentId = the client's owner when the follow-up was written, re-stamped on transfer).
      allow read: if isTeamLeader() || (isStaff() && (
        resource.data.agentId == request.auth.uid || ownOrPool(resource.data.clientAgentId)));
      // A follow-up is written by its own agent, about a client they can see.
      allow create: if isTeamLeader() || (isStaff() &&
        request.resource.data.get('agentId', '') == request.auth.uid &&
        canSeeClientId(request.resource.data.get('clientId', '')));
      allow update, delete: if isManager();
    }

    // Invitations are private: leaders manage them; an invited person can read and
    // mark only their own (needed by the sign-in flow).
    match /invitations/{id} {
      allow read: if isTeamLeader() ||
        (isAuthenticated() && resource.data.get('email', '') == request.auth.token.email);
      // Only an admin can invite a leader/manager/admin; other leaders invite sales only.
      allow create: if isAdmin() || (isTeamLeader() && isSalesRole(request.resource.data.get('role', '')));
      allow delete: if isAdmin() || (isTeamLeader() && isSalesRole(resource.data.get('role', '')));
      allow update: if isTeamLeader() ||
        (isAuthenticated() && resource.data.get('email', '') == request.auth.token.email &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
    }

    // Mirror used by the rules above (docId = lower-case email). Leaders write it
    // together with the invitation.
    match /allowed_users/{email} {
      allow read: if isTeamLeader() || (isAuthenticated() && request.auth.token.email == email);
      // This mirror decides which role a person may self-create (users create rule), so a
      // non-admin leader may only grant / change / remove sales invitations.
      allow create: if isAdmin() || (isTeamLeader() && isSalesRole(request.resource.data.get('role', '')));
      allow update: if isAdmin() || (isTeamLeader() && isSalesRole(resource.data.get('role', '')) &&
        isSalesRole(request.resource.data.get('role', '')));
      allow delete: if isAdmin() || (isTeamLeader() && isSalesRole(resource.data.get('role', '')));
    }

    // Merge audit trail for the Duplicates page (admin only).
    match /merged_clients/{id} {
      allow read, write: if isAdmin();
    }

    // Bookings the accounting sync could not attach to exactly one client (managers resolve).
    match /sync_review/{id} {
      allow read, write: if isManager();
    }

    match /client_merges/{id} {
      allow read, write: if isAdmin();
    }

    // Feature switches (e.g. app_settings/assistant { enabled: true }).
    match /app_settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /logs/{id} {
      allow read: if isStaff();
      // A log line is always written in the writer's own name (the server writes the rest).
      allow create: if isAdmin() || (isStaff() && request.resource.data.get('userId', '') == request.auth.uid);
    }

    match /services/{id} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    match /labels/{id} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    match /reports/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidReport(request.resource.data);
      allow update: if isStaff() && (resource.data.userId == request.auth.uid || isManager());
      allow delete: if isManager();
    }

    match /targets/{id} {
      allow read: if isStaff();
      allow write: if isTeamLeader();
    }

    match /defaultTargets/{id} {
      allow read: if isStaff();
      allow write: if isTeamLeader();
    }

    match /transfers/{id} {
      allow read: if isTeamLeader() || (isStaff() && (resource.data.oldAgentId == request.auth.uid || resource.data.newAgentId == request.auth.uid));
      // Leaders record transfers; a sales agent may record only their own claim from the pool.
      allow create: if isTeamLeader() || (isStaff() &&
        request.resource.data.get('newAgentId', '') == request.auth.uid &&
        request.resource.data.get('oldAgentId', '') == poolUid());
    }

    match /bulk_transfers/{id} {
      allow read: if isTeamLeader();
      allow create, update: if isTeamLeader();
    }

    match /shifts/{id} {
      allow read: if isStaff();
      // Admin resets and manager edits are free. The owner can only open a fresh shift "now"
      // and walk it through the normal steps: start, break on/off (appending, never rewriting
      // earlier breaks), end, and link the day's report. Times are checked against the clock.
      allow create: if isAdmin() || (isStaff() &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.keys().hasOnly(['userId', 'userName', 'date', 'createdAt', 'status', 'preShiftReviewStartedAt', 'breaks']) &&
        request.resource.data.status == 'reviewing' &&
        request.resource.data.breaks.size() == 0 &&
        isNowMs(request.resource.data.createdAt));
      allow update: if isManager() || (isStaff() && resource.data.userId == request.auth.uid && (
        // reviewing -> active
        (resource.data.status == 'reviewing' && request.resource.data.status == 'active' &&
          onlyKeys(['status', 'startedAt', 'preShiftReviewDurationMs']) && isNowMs(request.resource.data.startedAt)) ||
        // active -> on_break: one new open break appended
        (resource.data.status == 'active' && request.resource.data.status == 'on_break' && onlyKeys(['status', 'breaks']) &&
          request.resource.data.breaks.size() == resource.data.breaks.size() + 1 &&
          request.resource.data.breaks.size() <= 6 &&
          request.resource.data.breaks[0:resource.data.breaks.size()] == resource.data.breaks &&
          isNowMs(request.resource.data.breaks[resource.data.breaks.size()].startedAt)) ||
        // on_break -> active: only the last break gets closed
        (resource.data.status == 'on_break' && request.resource.data.status == 'active' && onlyKeys(['status', 'breaks']) &&
          request.resource.data.breaks.size() == resource.data.breaks.size() &&
          request.resource.data.breaks.size() > 0 &&
          request.resource.data.breaks[0:resource.data.breaks.size() - 1] == resource.data.breaks[0:resource.data.breaks.size() - 1] &&
          request.resource.data.breaks[resource.data.breaks.size() - 1].startedAt == resource.data.breaks[resource.data.breaks.size() - 1].startedAt &&
          isNowMs(request.resource.data.breaks[resource.data.breaks.size() - 1].endedAt)) ||
        // any open state -> ended
        (resource.data.status != 'ended' && request.resource.data.status == 'ended' &&
          onlyKeys(['status', 'endedAt']) && isNowMs(request.resource.data.endedAt)) ||
        // link the day's report
        onlyKeys(['reportId'])
      ));
    }
  }
}
