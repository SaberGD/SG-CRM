# Meta Conversions API secrets - loaded automatically by Firebase at deploy time.
# Pixel ID from Meta Events Manager (not secret)
META_PIXEL_ID=
# Access token from Events Manager -> Pixel -> Settings -> Conversions API (SECRET)
META_ACCESS_TOKEN=

# Gemini AI bridge secret - loaded automatically by Firebase at deploy time.
# API key restricted to the Generative Language API, from GCP Console -> Credentials (SECRET)
GEMINI_API_KEY=
